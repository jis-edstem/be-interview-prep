meta {
  name: My profile
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("returns the logged-in user", function() {
    expect(res.status).to.equal(200);
    expect(res.body.email).to.equal(bru.getEnvVar("email"));
  });
}
