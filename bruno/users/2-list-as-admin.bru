meta {
  name: List users as admin
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/users
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("returns every user", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}
