meta {
  name: Update product as admin
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/products/{{productId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

body:json {
  {
    "name": "Books item 1",
    "category": "Books",
    "price": 19.99,
    "stock": 25,
    "rating": 4.5,
    "version": {{productVersion}}
  }
}

tests {
  test("updates the product", function() {
    expect(res.status).to.equal(200);
  });
}
