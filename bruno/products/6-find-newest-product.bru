meta {
  name: Find newest product
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/products?sort=id,desc&size=1
  body: none
  auth: bearer
}

params:query {
  sort: id,desc
  size: 1
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  bru.setVar("deleteProductId", res.body.content[0].id);
}

tests {
  test("returns a product", function() {
    expect(res.status).to.equal(200);
    expect(res.body.content).to.have.lengthOf(1);
  });
}
