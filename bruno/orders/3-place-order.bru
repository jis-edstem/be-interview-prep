meta {
  name: Place order
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/orders
  body: json
  auth: bearer
}

headers {
  Idempotency-Key: {{idempotencyKey}}
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "items": [{ "productId": {{productId}}, "quantity": 1 }]
  }
}

script:pre-request {
  bru.setVar("idempotencyKey", bru.interpolate("{{$guid}}"));
}

script:post-response {
  bru.setVar("orderId", res.body.id);
}

tests {
  test("creates the order", function() {
    expect(res.status).to.equal(201);
    expect(res.body.status).to.equal("PLACED");
  });
}
