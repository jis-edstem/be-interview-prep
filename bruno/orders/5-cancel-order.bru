meta {
  name: Cancel order
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/orders/{{orderId}}/cancel
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("cancels the order", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("CANCELLED");
  });
}
