meta {
  name: Create task
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/tasks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Write the order service",
    "description": "Q5",
    "status": "TODO",
    "dueDate": "2099-01-01"
  }
}

script:post-response {
  bru.setVar("taskId", res.body.id);
  bru.setVar("taskVersion", res.body.version);
}

tests {
  test("creates the task", function() {
    expect(res.status).to.equal(201);
  });
}
