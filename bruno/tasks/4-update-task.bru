meta {
  name: Update task
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/tasks/{{taskId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Write the order service",
    "description": "Q5",
    "status": "IN_PROGRESS",
    "dueDate": "2099-01-01",
    "version": {{taskVersion}}
  }
}

tests {
  test("updates the task", function() {
    expect(res.status).to.equal(200);
    expect(res.body.status).to.equal("IN_PROGRESS");
  });
}
